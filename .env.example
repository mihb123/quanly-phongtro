APP_ENV=dev
# Trống = tự bật khi APP_ENV khác "dev".
COOKIE_SECURE=
APP_URL=production.site
APP_URL_DEV=localhost
APP_PORT_DEV=9180

APP_PORT=9185
# Proxy/tunnel CIDRs tin cậy cho X-Forwarded-Proto/Host (DPoP htu khi TLS terminate ở proxy). Trống = không tin proxy nào.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/quanly_phongtro?sslmode=disable # REQUIRED
ACCESS_TOKEN_JWT_SECRET=change-me # REQUIRED
REFRESH_TOKEN_JWT_SECRET=change-me-2 # REQUIRED
JWT_TTL_MINUTES=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME= # REQUIRED
SMTP_PASSWORD= # REQUIRED
OTP_EXPIRE_MINUTES=3 # REQUIRED
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Quan ly phong tro
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_BOT_ENCRYPTION_KEY=example_secret_token # REQUIRED
# Hex 64 ký tự (32 bytes). Trống = dùng lại ZALO_BOT_ENCRYPTION_KEY; production nên khai riêng.
APP_SECRET_ENCRYPTION_KEY=
# Khóa ký URL ảnh hóa đơn Zalo. Trống = dùng lại ACCESS_TOKEN_JWT_SECRET; production nên khai riêng.
UPLOAD_URL_SIGNING_KEY=
GOOGLE_MAP_API_KEY=
# Credential PayOS cấp ứng dụng, chỉ có tác dụng khi khai đủ cả 3; để trống nếu mỗi manager tự cấu hình trong app.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
