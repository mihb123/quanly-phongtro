APP_ENV=dev
APP_URL=production.site
APP_URL_DEV=localhost

APP_PORT=9185
# Proxy/tunnel CIDRs tin cậy cho X-Forwarded-Proto/Host (DPoP htu khi TLS terminate ở proxy). Trống = không tin proxy nào.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/quanly_phongtro?sslmode=disable # REQUIRED
ACCESS_TOKEN_JWT_SECRET=change-me # REQUIRED
REFRESH_TOKEN_JWT_SECRET=change-me-2 # REQUIRED
JWT_TTL_MINUTES=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME= # REQUIRED
SMTP_PASSWORD= # REQUIRED
OTP_EXPIRE_MINUTES=3 # REQUIRED
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Quan ly phong tro
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_BOT_ENCRYPTION_KEY=example_secret_token # REQUIRED
APP_SECRET_ENCRYPTION_KEY=
GOOGLE_MAP_API_KEY=
