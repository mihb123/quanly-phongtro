[Unit]
Description=QuanLyPhongTro API Backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/quanly-phongtro-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
